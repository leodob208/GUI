import pygame 
pygame.init()
screen =pygame.display.set_mode((800,800))
pygame.display.set_caption ("ping pong")
running = True
redbat=pygame.image.load("red_ping_pong_bat_-removebg-preview.png")
redbat = pygame.transform.scale(redbat, (100, 100))
redbatsprite=redbat.get_rect()
bluebat=pygame.image.load("blue_ping_pong_bat_-removebg-preview.png")
bluebat = pygame.transform.scale(bluebat, (100, 100))
redbatsprite.center = (50,500)
bluebatsprite=bluebat.get_rect()
bluebatsprite.center = (750,500)
ball=pygame.image.load("ping_pong_ball-removebg-preview.png")
ball = pygame.transform.scale(ball, (30, 30))
ballsprite=ball.get_rect()

front1=pygame.font.SysFont('Arial',25)
text1=front1.render('red player score: 0',True,'black')
font2=pygame.font.SysFont('Arial',25)
text2=font2.render('blue player score: 0',True,'black')
redscore=0
bluescore=0
dx=-0.7
dy=0.7                                  
bx=400                                  
by=400                                  
ballsprite.center = (bx,by)                                 



while running:                                  
    bx += dx                                    
    by += dy                                    
    if by<0:                                    
        dy=dy*-1                                    
    if by>800:                                  
        dy=dy*-1                                    
    if ballsprite.colliderect(redbatsprite) or ballsprite.colliderect(bluebatsprite):                                   
        dx=dx*-1                                    
    if bx<0:                                    
        bluescore += 1                                  
        text2=font2.render('blue player score: '+str(bluescore),True,'black')                                   
        bx=400    
                                      
        by=400                                  
                                 
        dy=0.7                                  
    if bx>800:                                  
        redscore += 1                                   
        text1=front1.render('red player score: '+str(redscore),True,'black')                                    
        bx=400                                  
        by=400                                  
                                      
        dy=0.7
    

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
    keys = pygame.key.get_pressed()
    if keys[pygame.K_w]:
        redbatsprite.y -= 5
    if keys[pygame.K_s]:
        redbatsprite.y += 5
    if keys[pygame.K_a] and redbatsprite.x > -25:
        redbatsprite.x -= 5
    if keys[pygame.K_d] and redbatsprite.x < 350:
        redbatsprite.x += 5
    if keys[pygame.K_UP]:
        bluebatsprite.y -= 5    
    if keys[pygame.K_DOWN]:
        bluebatsprite.y += 5
    if keys[pygame.K_LEFT] and bluebatsprite.x > 400:
        bluebatsprite.x -= 5
    if keys[pygame.K_RIGHT] and bluebatsprite.x < 780:
        bluebatsprite.x += 5



    screen.fill(('yellow'))

    pygame.draw.rect(screen, "white", (150, 20, 200, 70))
    pygame.draw.rect(screen, "white", (450, 20, 200, 70))

   



  
    
    
    
    ballsprite.center = (bx,by)
    screen.blit(redbat, redbatsprite)
    screen.blit(bluebat, bluebatsprite)
    screen.blit(ball, ballsprite)
    screen.blit(text1, (100, 20))
    screen.blit(text2, (500, 20))
    pygame.draw.line(screen, ('black'), (400,0), (400,800), 3)
    pygame.display.update()
pygame.quit()

